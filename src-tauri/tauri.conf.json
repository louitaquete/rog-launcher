{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rog Launcher",
  "version": "0.1.0",
  "identifier": "com.louitaquete.roglauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rog Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}