{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rog Launcher Installer",
  "version": "1.0.4",
  "identifier": "com.louitaquete.roglauncher.installer",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instalador do Rog Launcher",
        "width": 760,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
